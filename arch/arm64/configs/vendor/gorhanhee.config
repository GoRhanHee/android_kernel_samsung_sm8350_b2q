# Disable Samsung anit-root protection
CONFIG_FASTUH=n
CONFIG_FASTUH_RKP=n
CONFIG_FASTUH_KDP=n

CONFIG_SECURITY_DEFEX=n
CONFIG_PROCA=n
CONFIG_FIVE=n

CONFIG_INTEGRITY=n
CONFIG_KPERFMON=n
CONFIG_KPERFMON_BUILD=n

# Localversion
CONFIG_LOCALVERSION="-qgki-GoRhanHee_Kernel"
CONFIG_LOCALVERSION_AUTO=n

# Disable CRYPTO_FIPS
CONFIG_CRYPTO_FIPS=n

# Enable dt_overlay
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# Default Disable KernelSU
CONFIG_KSU=n